#!/bin/bash
# Print this machine's effective keybindings as JSON.
#
# Reuses the resolver inside omarchy-menu-keybindings (the one behind
# SUPER + K), so the output is what Hyprland has bound right now: Omarchy
# defaults plus every override and unbind in ~/.config/hypr/*.lua.
#
# {
#   "binds": [{ "combo": "SUPER + B", "description": "Browser", "dispatcher": "exec", "arg": "omarchy-launch-browser" }],
#   "defaults": { "browser": ["brave-origin"], "editor": ["code"] }
# }

set -o pipefail

resolver=$(command -v omarchy-menu-keybindings) || exit 1

# Source only the function definitions above output_keybindings, never the
# interactive tail that opens the menu.
source <(sed -n '1,/^output_keybindings() {/p' "$resolver" | sed '$d')

records() {
  if declare -F output_binding_records >/dev/null; then
    # "<combo padded> → <description>\t<dispatcher>\t<arg>"
    output_binding_records
  else
    "$resolver" --print | sed 's/$/\t\t/'
  fi
}

# Every name the default browser's window might carry: desktop id, Exec
# binary, StartupWMClass. omarchy-browser.desktop is a wrapper, so resolve
# the real browser through omarchy-cmd-default-browser first.
browser_names() {
  local id entry dir
  id=$(omarchy-cmd-default-browser 2>/dev/null)
  [[ -z $id ]] && id=$(xdg-settings get default-web-browser 2>/dev/null)
  [[ -z $id ]] && return
  printf '%s\n' "${id%.desktop}"
  IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for dir in "${dirs[@]}"; do
    entry="$dir/applications/$id"
    [[ -f $entry ]] || continue
    sed -n 's/^Exec=\([^ ]*\).*/\1/p; s/^StartupWMClass=//p' "$entry" | xargs -r -n1 basename
    break
  done
}

editor_names() {
  local editor=nvim file="$HOME/.local/state/omarchy/defaults/editor"
  [[ -f $file ]] && read -r editor <"$file"
  [[ $editor == sublime_text ]] && editor=subl
  editor=${editor##*/}
  printf '%s\n' "$editor" "org.omarchy.$editor"
  [[ $editor == code ]] && printf '%s\n' com.microsoft.VSCode
  [[ $editor == subl ]] && printf '%s\n' sublime_text
  true
}

to_json_array() { jq -Rn '[inputs | select(length > 0)] | unique'; }

browsers=$(browser_names | to_json_array)
editors=$(editor_names | to_json_array)

records | jq -Rn --argjson browser "$browsers" --argjson editor "$editors" '
  {
    binds: [
      inputs
      | split("\t") as $f
      | ($f[0] | split(" → ")) as $head
      | select(($head | length) >= 2)
      | {
          combo: ($head[0] | sub("\\s+$"; "")),
          description: ($head[1:] | join(" → ")),
          dispatcher: ($f[1] // ""),
          arg: ($f[2:] | join("\t"))
        }
    ],
    defaults: { browser: $browser, editor: $editor }
  }'
